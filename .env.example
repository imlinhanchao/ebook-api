# 服务监听地址（默认 127.0.0.1:8091，避免与 echo-service 的 8090 冲突）
EBOOK_ADDR=127.0.0.1:8091

# 数据目录（未配置 EBOOK_SECRET 时，自动在此目录生成并持久化 secret.key）
EBOOK_DATA_DIR=data

# 32 字节 AES-256-GCM 密钥（base64 或 hex），用于加密/解密 credential_token
# 留空则自动生成并写入 <EBOOK_DATA_DIR>/secret.key
EBOOK_SECRET=

# 是否允许明文凭据请求头（X-Provider-Credentials / X-Provider-Cred-*）
# 默认 false，强烈建议保持关闭，使用 X-Provider-Token 传递加密令牌
EBOOK_ALLOW_PLAIN_CRED_HEADERS=false

# 可选：服务级 API Key（留空表示不启用鉴权，仅建议用于本机/内网）
# 启用后客户端需通过 Authorization: Bearer <key> 或 X-API-Key: <key> 鉴权
EBOOK_API_KEY=

# 是否允许 GET 下载接口跳过 EBOOK_API_KEY 鉴权（方便接入 CDN 或直接下载链接）
EBOOK_PUBLIC_DOWNLOAD=false

# 下载响应的 Cache-Control 头（便于 CDN 缓存同一本书并减少上游配额消耗）
EBOOK_DOWNLOAD_CACHE_CONTROL=public, max-age=2592000, immutable

# 默认书源 ID（搜索未指定 provider 时使用）
EBOOK_DEFAULT_PROVIDER=zlib

# 启用的书源列表（逗号分隔，留空表示启用所有已注册书源）
EBOOK_ENABLED_PROVIDERS=

# 单文件最大下载大小（MB，0 表示不限制）
EBOOK_MAX_DOWNLOAD_MB=500

# 允许的 CORS Origin（逗号分隔，留空表示不添加 CORS 头，* 表示允许所有）
EBOOK_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Z-Library 书源配置
# ---------------------------------------------------------------------------
# 镜像域名列表（逗号分隔，按优先级排序）
ZLIB_DOMAINS=https://z-lib.gd,https://z-lib.gl,https://z-library.ec,https://zlib.bz

# 可选：服务端默认 Z-Library 凭据（请求未携带凭据时作为回退）
# 也可使用通用格式：EBOOK_CRED_<PROVIDER>_<KEY>=...
ZLIB_DOMAIN=
ZLIB_REMIX_USERID=
ZLIB_REMIX_USERKEY=

# ---------------------------------------------------------------------------
# 内置公版书源配置（可选自定义镜像或默认凭据）
# ---------------------------------------------------------------------------
GUTENDEX_DOMAIN=https://gutendex.com
STANDARD_EBOOKS_DOMAIN=https://standardebooks.org
WENSHUOGE_DOMAIN=https://www.wenshuoge.com
WENSHUOGE_SESSION=
